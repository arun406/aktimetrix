<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>2.7.0</version>
        <relativePath/> <!-- lookup parent from repository -->
    </parent>
    <packaging>pom</packaging>
    <groupId>com.aktimetrix</groupId>
    <artifactId>aktimetrix</artifactId>
    <version>0.1.0</version>
    <name>Aktimetrix</name>
    <description>Event-driven business process monitoring for the JVM: plans each step of a business process,
        records what actually happens, and flags steps that are late, at risk, or overdue.</description>
    <url>https://github.com/arun406/aktimetrix</url>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>
    <developers>
        <developer>
            <id>arun406</id>
            <name>Arun Kumar Kandakatla</name>
            <url>https://github.com/arun406</url>
        </developer>
    </developers>
    <scm>
        <connection>scm:git:https://github.com/arun406/aktimetrix.git</connection>
        <developerConnection>scm:git:git@github.com:arun406/aktimetrix.git</developerConnection>
        <url>https://github.com/arun406/aktimetrix</url>
    </scm>
    <issueManagement>
        <system>GitHub</system>
        <url>https://github.com/arun406/aktimetrix/issues</url>
    </issueManagement>

    <properties>
        <!-- compile against the Java 11 API, whatever JDK builds it -->
        <maven.compiler.release>11</maven.compiler.release>
        <java.version>11</java.version>
        <spring-cloud.version>2021.0.1</spring-cloud.version>
        <!-- overrides the version managed by Spring Boot: 1.18.34 is the first to support JDK 21 -->
        <lombok.version>1.18.34</lombok.version>
    </properties>
    <modules>
        <module>aktimetrix-core</module>
        <module>aktimetrix-store-mongodb</module>
        <module>aktimetrix-store-jdbc</module>
        <module>aktimetrix-store-memory</module>
        <module>aktimetrix-broker-kafka</module>
        <module>aktimetrix-broker-rabbitmq</module>
        <module>aktimetrix-tests</module>
    </modules>

    <!-- all other versions are managed by spring-boot-starter-parent -->
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.aktimetrix</groupId>
                <artifactId>aktimetrix-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.aktimetrix</groupId>
                <artifactId>aktimetrix-store-mongodb</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.aktimetrix</groupId>
                <artifactId>aktimetrix-store-jdbc</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.aktimetrix</groupId>
                <artifactId>aktimetrix-store-memory</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.aktimetrix</groupId>
                <artifactId>aktimetrix-broker-kafka</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.aktimetrix</groupId>
                <artifactId>aktimetrix-broker-rabbitmq</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>de.bwaldvogel</groupId>
                <artifactId>mongo-java-server</artifactId>
                <version>1.44.0</version>
            </dependency>
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${spring-cloud.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <profiles>
        <!--
          Publishing to Maven Central: sources and javadoc jars, GPG signatures, and upload through the Sonatype
          Central Portal. Used by .github/workflows/release.yml; see RELEASING.md.
        -->
        <profile>
            <id>release</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-source-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>attach-sources</id>
                                <goals>
                                    <goal>jar-no-fork</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-javadoc-plugin</artifactId>
                        <configuration>
                            <doclint>none</doclint>
                            <quiet>true</quiet>
                        </configuration>
                        <executions>
                            <execution>
                                <id>attach-javadocs</id>
                                <goals>
                                    <goal>jar</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-gpg-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>sign-artifacts</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>sign</goal>
                                </goals>
                                <configuration>
                                    <gpgArguments>
                                        <arg>--pinentry-mode</arg>
                                        <arg>loopback</arg>
                                    </gpgArguments>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.sonatype.central</groupId>
                        <artifactId>central-publishing-maven-plugin</artifactId>
                        <version>0.5.0</version>
                        <extensions>true</extensions>
                        <configuration>
                            <publishingServerId>central</publishingServerId>
                            <autoPublish>true</autoPublish>
                            <waitUntil>published</waitUntil>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
