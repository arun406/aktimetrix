    <dependencies>
        <dependency>
            <groupId>com.aktimetrix</groupId>
            <artifactId>aktimetrix-core</artifactId>
        </dependency>
        <dependency>
            <groupId>com.aktimetrix</groupId>
            <artifactId>aktimetrix-store-mongodb</artifactId>
        </dependency>
        <dependency>
            <groupId>com.aktimetrix</groupId>
            <artifactId>aktimetrix-store-jdbc</artifactId>
        </dependency>
        <dependency>
            <groupId>com.aktimetrix</groupId>
            <artifactId>aktimetrix-store-memory</artifactId>
        </dependency>
        <dependency>
            <groupId>com.aktimetrix</groupId>
            <artifactId>aktimetrix-broker-kafka</artifactId>
        </dependency>
        <dependency>
            <groupId>com.aktimetrix</groupId>
            <artifactId>aktimetrix-broker-rabbitmq</artifactId>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
